  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DBColaborador</DataSourceName>
        <CommandText>SELECT CO.IdColaborador, CO.Nombres, CO.Apellidos, CO.DNI, CO.Sexo, CO.Direccion, EM.RazonSocial FROM Colaborador CO, Empresa EM WHERE CO.IdEmpresa=EM.IdEmpresa</CommandText>
      </Query>
      <Fields>
        <Field Name="IdColaborador">
          <DataField>IdColaborador</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Nombres">
